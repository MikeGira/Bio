{
  "version": 2,
  "functions": {
    "api/chat.js":           { "maxDuration": 60 },
    "api/db.js":             { "maxDuration": 30 },
    "api/analytics-auth.js": { "maxDuration": 10 },
    "api/send-digest.js":    { "maxDuration": 60 },
    "api/stats.js":          { "maxDuration": 15 },
    "api/visitors.js":       { "maxDuration": 10 }
  },
  "routes": [
    { "src": "/api/chat",            "dest": "/api/chat.js" },
    { "src": "/api/db",              "dest": "/api/db.js" },
    { "src": "/api/db\\?.*",         "dest": "/api/db.js" },
    { "src": "/api/stats",           "dest": "/api/stats.js" },
    { "src": "/api/stats\\?.*",      "dest": "/api/stats.js" },
    { "src": "/api/visitors",        "dest": "/api/visitors.js" },
    { "src": "/stats",               "dest": "/stats.html" },
    { "src": "/analytics",           "dest": "/analytics.html" },
    { "src": "/api/analytics-auth",  "dest": "/api/analytics-auth.js" },
    { "src": "/api/send-digest",     "dest": "/api/send-digest.js" },
    { "src": "/(.*)",                "dest": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "X-XSS-Protection",          "value": "1; mode=block" },
        { "key": "Content-Security-Policy",   "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.vercel-insights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://api.anthropic.com https://api.resend.com https://vitals.vercel-insights.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/analytics",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}